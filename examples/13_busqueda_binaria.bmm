fn binary_search(a, target)
  let lo = 0
  let hi = len(a) - 1
  loop lo <= hi
    let mid = (lo + hi) / 2
    if a[mid] == target
      ret mid
    end
    if a[mid] < target
      lo = mid + 1
    else
      hi = mid - 1
    end
  end
  ret -1
end

let a = [1, 3, 5, 7, 9, 11, 13]
println(str(binary_search(a, 7)))
println(str(binary_search(a, 2)))
