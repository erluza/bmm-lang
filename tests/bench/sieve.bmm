let N = 50
let sieve = arr()
let i = 0
loop i <= N
  push(sieve, 1)
  i = i + 1
end
sieve[0] = 0
sieve[1] = 0
let p = 2
loop p * p <= N
  if sieve[p] == 1
    let q = p * p
    loop q <= N
      sieve[q] = 0
      q = q + p
    end
  end
  p = p + 1
end
let k = 2
loop k <= N
  if sieve[k] == 1
    println(str(k))
  end
  k = k + 1
end
